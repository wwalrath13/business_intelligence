library(tidyverse)
library(haven)
library(broom)
edu_wages <- read_dta("https://github.com/pnencka/data/blob/main/edu_wages.dta?raw=true")
glimpse(edu_wages)
edu_wage_regression <- lm(log_real_wage ~ years_of_education, data = edu_wages)
tidy(edu_wage_regression)
broom(edu_wage_regression)
tidy(edu_wage_regression)
ggplot(edu_wages, aes(x = years_of_education, y = log_real_wage))+
geom_point()+
geom_point()geom_smooth(method = "lm")
ggplot(edu_wages, aes(x = years_of_education, y = log_real_wage))+
geom_point() +
geom_point()geom_smooth(method = "lm")
ggplot(edu_wages, aes(x = years_of_education, y = log_real_wage))+
geom_point() +
geom_smooth(method = "lm")
tidy(edu_ability_wage_regression)
edu_ability_wage_regression <- lm(log_real_wage ~ years_of_education + math_reading_test_score, data = edu_wages)
tidy(edu_ability_wage_regression)
test_education <- lm(math_reading_test_score ~ years_of_education, data = edu_wages)
tidy(test_education)
# the following coding was done with the help of Artificial Intelegence
pi1 <- coef(test_education)["Years_of_Education"]
beta2 <- coef(edu_ability_wage_regression)["math_reading_test_score"]
OVB_Formula <- pi1 * beta2
print(OVB_Formula)
