install.packages("forcats")
install.packages("moderndive")
library(ggplot2)
library(dplyr)
library(forcats)
library(moderndive)
glimpse(gss_cat)
gss_cat %>%
summarize(divorced = sum(marital == "Divorced"),
N = n()) %>%
mutate(p = divorced / N)
n50_1000rep <- gss_cat %>%
rep_sample_n(size = 50, reps = 1000)
p_hat_n50_1000rep <- n50_1000rep %>%
group_by(replicate) %>%
summarize(divorce_count = sum(marital == "Divorced"),
n = n()) %>%
mutate(p_hat = divorce_count / n)
p_hat_n50_1000rep
ggplot(p_hat_n50_1000rep, aes(x = p_hat)) +
geom_histogram(binwidth = 0.02, color = "black", fill = "aquamarine3", boundary=0) +
labs(x = "Sample proportion of divorced respondents",
title = "Sampling distribution of p-hat based on n = 50")
n300_1000rep <- gss_cat %>%
rep_sample_n(size = 300, reps = 1000)
p_hat_n300_1000rep <- n300_1000rep %>%
group_by(replicate) %>%
summarize(divorce_count = sum(marital == "Divorced"),
n = n()) %>%
mutate(p_hat = divorce_count / n)
ggplot(p_hat_n300_1000rep, aes(x = p_hat)) +
geom_histogram(binwidth = 0.02, color = "black", fill = "aquamarine3", boundary=0) +
labs(x = "Sample proportion of divorced respondents",
title = "Sampling distribution of p-hat based on n = 300")
n100_10000rep <- gss_cat %>%
rep_sample_n(size = 100, reps = 10000)
p_hat_n100_10000rep <- n100_10000rep %>%
group_by(replicate) %>%
summarize(divorce_count = sum(marital == "Divorced"),
n = n()) %>%
mutate(p_hat = divorce_count / n)
ggplot(p_hat_n100_10000rep, aes(x = p_hat)) +
geom_histogram(binwidth = 0.02, color = "black", fill = "aquamarine3", boundary=0) +
labs(x = "Sample proportion of divorced respondents",
title = "Sampling distribution of p-hat based on n = 100")
